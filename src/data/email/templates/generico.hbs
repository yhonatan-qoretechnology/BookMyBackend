<!doctype html>
<html lang="es">
  <body style="margin:0;padding:24px;background:#f2f6f4;font-family:Arial,Helvetica,sans-serif;color:#101a24;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;border:1px solid #e4ece8;">
      <tr>
        <td style="padding:26px 28px 6px;">
          <p style="margin:0;font-size:13px;font-weight:800;color:#0a7b56;">Bookmy</p>
          <h1 style="margin:8px 0 0;font-size:20px;line-height:1.3;">{{titulo}}</h1>
        </td>
      </tr>
      <tr>
        <td style="padding:10px 28px 26px;font-size:14.5px;line-height:1.65;">
          {{#each parrafos}}
          <p style="margin:0 0 14px;white-space:pre-line;">{{this}}</p>
          {{/each}}
          {{#if boton}}
          <p style="margin:20px 0 0;">
            <a href="{{boton.url}}" style="display:inline-block;padding:12px 20px;border-radius:12px;background:#12b981;color:#ffffff;font-weight:700;text-decoration:none;">{{boton.texto}}</a>
          </p>
          {{/if}}
        </td>
      </tr>
      <tr>
        <td style="padding:14px 28px 22px;border-top:1px solid #eef4f1;font-size:12px;color:#94a3b8;">
          Recibes este correo porque tu negocio usa Bookmy.
        </td>
      </tr>
    </table>
  </body>
</html>
