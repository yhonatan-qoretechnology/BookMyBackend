
# Para trabajar en local sin tocar produccion, pon tus valores en un
# .env.local (ignorado por git): el backend lo lee ANTES que el .env y sus
# valores ganan. Ahi van la DATABASE_URL de la base de desarrollo, un
# JWT_SECRET_KEY de prueba, STORAGE_MODE=local, un EMAIL_HOST que no mande
# correos de verdad... (lo carga src/config/env-local.ts, el primer import de
# main.ts y de la semilla). Ojo: la CLI de Prisma y los scripts de scripts/
# que van directos a la base solo leen el .env, asi que antes de usarlos
# exporta DATABASE_URL en la terminal.

# URL publica del panel, para los enlaces de los correos.
# En produccion es obligatoria: sin ella el backend no arranca, en vez de
# mandar enlaces a localhost. El dia que el panel viva en su dominio, en
# produccion vale https://bookmy.es. Este fichero es la plantilla de LOCAL.
APP_URL=http://localhost:3000

# Base publica desde la que se sirven los ficheros subidos por SFTP al espacio
# web de IONOS. Hoy es https://bookmy.es; cuando exista el subdominio propio de
# ficheros pasara a ser https://cdn.bookmy.es.
UPLOADS_PUBLIC_BASE_URL=https://bookmy.es

# Opcional. Base publica ANTERIOR, solo para poder BORRAR ficheros ya subidos:
# las URLs guardadas en la base de datos con la base vieja se siguen
# reconociendo. Se rellena el dia que cambie UPLOADS_PUBLIC_BASE_URL (ese dia,
# aqui: https://bookmy.es). Si falta, el borrado se comporta igual que hoy.
UPLOADS_PUBLIC_BASE_URL_ANTERIOR=

# Opcional, para desarrollo. Con "local" las subidas se guardan en ./uploads
# de esta maquina (y se sirven en /uploads) aunque esten puestas las SFTP_*,
# que en el .env apuntan al espacio web de produccion. Sin ella, o con
# "sftp", se usa SFTP cuando esta configurado, como siempre.
# STORAGE_MODE=local

# Opcional. Aviso a la web de un negocio cuando cambia su inventario, para que
# refresque al momento el catalogo que lee de GET /catalogo-web/:empresaId.
# Solo avisa de los cambios del negocio CATALOGO_WEB_EMPRESA_ID, con la
# cabecera "Authorization: Bearer <CATALOGO_WEB_WEBHOOK_SECRET>" (el mismo
# secreto que tiene configurado la web). Sin las tres no se avisa a nadie.
# Hoy es la web de QORE Technology: en produccion
# https://qoretechnology.com/api/bookmy/catalogo, en local
# http://localhost:3000/api/bookmy/catalogo.
CATALOGO_WEB_WEBHOOK_URL=
CATALOGO_WEB_WEBHOOK_SECRET=
CATALOGO_WEB_EMPRESA_ID=

# Opcional. Cuenta de Bookmy a la que el cliente transfiere cuando paga una
# cita por Wise (transferencia bancaria manual, no hay pasarela). Sin estas
# dos el pago queda igual en PENDING, solo que sin datos de cuenta que
# mostrarle al cliente.
BOOKMY_WISE_IBAN=
BOOKMY_WISE_TITULAR=

# Pasarela de cobro al cliente (Stripe). Claves de prueba (sk_test_...) en
# desarrollo. El webhook apunta a POST /payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# reCAPTCHA v3 de los formularios públicos (contacto, crear cuenta, login).
# Clave SECRETA de https://www.google.com/recaptcha/admin (la del sitio va en
# el panel como NEXT_PUBLIC_RECAPTCHA_SITE_KEY). Vacía = no se verifica.
RECAPTCHA_SECRET_KEY=
# Puntuación mínima de Google para aceptar (0 = bot, 1 = humano).
RECAPTCHA_MIN_SCORE=0.5
# Buzón que recibe los formularios de contacto de bookmy.es.
CONTACT_EMAIL=contacto@bookmy.es

# Referidos: puntos para el negocio que invita y bienvenida para el invitado,
# cuando el invitado paga su primer mes de Pro.
REFERIDO_PUNTOS=100
REFERIDO_PUNTOS_BIENVENIDA=50

# URL del panel para los botones de los correos (avisos de buen uso de Pro).
PANEL_URL=https://bookmy.es/login
