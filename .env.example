
# Para trabajar en local sin tocar produccion, pon tus valores en un
# .env.local (ignorado por git): el backend lo lee ANTES que el .env y sus
# valores ganan. Ahi van la DATABASE_URL de la base de desarrollo, un
# JWT_SECRET_KEY de prueba, STORAGE_MODE=local, un EMAIL_HOST que no mande
# correos de verdad... (lo carga src/config/env-local.ts, el primer import de
# main.ts y de la semilla). Ojo: la CLI de Prisma y los scripts de scripts/
# que van directos a la base solo leen el .env, asi que antes de usarlos
# exporta DATABASE_URL en la terminal.

# URL publica del panel, para los enlaces de los correos.
# En produccion es obligatoria: sin ella el backend no arranca, en vez de
# mandar enlaces a localhost. El dia que el panel viva en su dominio, en
# produccion vale https://bookmy.es. Este fichero es la plantilla de LOCAL.
APP_URL=http://localhost:3000

# Base publica desde la que se sirven los ficheros subidos por SFTP al espacio
# web de IONOS. Hoy es https://bookmy.es; cuando exista el subdominio propio de
# ficheros pasara a ser https://cdn.bookmy.es.
UPLOADS_PUBLIC_BASE_URL=https://bookmy.es

# Opcional. Base publica ANTERIOR, solo para poder BORRAR ficheros ya subidos:
# las URLs guardadas en la base de datos con la base vieja se siguen
# reconociendo. Se rellena el dia que cambie UPLOADS_PUBLIC_BASE_URL (ese dia,
# aqui: https://bookmy.es). Si falta, el borrado se comporta igual que hoy.
UPLOADS_PUBLIC_BASE_URL_ANTERIOR=

# Opcional, para desarrollo. Con "local" las subidas se guardan en ./uploads
# de esta maquina (y se sirven en /uploads) aunque esten puestas las SFTP_*,
# que en el .env apuntan al espacio web de produccion. Sin ella, o con
# "sftp", se usa SFTP cuando esta configurado, como siempre.
# STORAGE_MODE=local
