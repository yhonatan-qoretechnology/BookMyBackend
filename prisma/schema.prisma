generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  people
  business
}

enum ClientState {
  enabled
  disabled
  blocked
}

model Users {
  id             Int            @id @default(autoincrement()) @map("id")
  email          String         @unique @map("email") @db.VarChar(100)
  clientType     ClientType     @default(people) @map("client_type")
  state          ClientState    @default(disabled) @map("state")
  acceptTerms    Boolean        @default(false) @map("accept_terms")
  acceptPolitics Boolean        @default(false) @map("accept_polits")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  UserCategories UserCategory[]
  UserData       UserData?      @relation("UserToUserData")
  UserAuth       UserAuth?      @relation("UserToUserAuth")
 UserLocation   UserLocation?   @relation("UserToLocation")
  @@index([email])
  @@map("users")
}

model UserAuth {
  id        Int      @id @default(autoincrement()) @map("id")
  email     String   @unique @map("email")
  password  String   @map("password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user_id Int   @unique @map("user_id")
  user    Users @relation("UserToUserAuth", fields: [user_id], references: [id])

  @@map("user_auth")
}

model UserData {
  id        Int     @id @default(autoincrement()) @map("id")
  name      String  @map("name") @db.VarChar(50)
  phone     String  @map("phone") @db.VarChar(20)
  email     String  @unique @map("email")
  genero    String  @map("nagenerome") @db.VarChar(50)
  idioma    String  @map("idioma") @db.VarChar(50)
  userId    Int     @unique @map("user_id")
  countryId Int     @map("country_id")
  user      Users   @relation("UserToUserData", fields: [userId], references: [id])
  country   Country @relation(fields: [countryId], references: [id])

  @@map("user_data")
}

model Country {
  id            Int                     @id @default(autoincrement()) @map("id")
  name          String                  @map("name")
  isoCode       String                  @unique @map("iso_code") @db.Char(2)
  flagUrl       String?                 @map("flag_url")
  dialingCode   String                  @map("dialing_code") @db.VarChar(10)
  UserData      UserData[]
  DocumentTypes DocumentTypeByCountry[]

  @@map("country")
}

model DocumentType {
  id      Int    @id @default(autoincrement())
  name    String @unique
  acronym String

  type          ClientType              @default(people)
  DocumentTypes DocumentTypeByCountry[]

  @@map("document_type")
}

model DocumentTypeByCountry {
  countryId      Int @map("country_id")
  documentTypeId Int @map("document_type_id")

  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])

  @@id([countryId, documentTypeId])
  @@map("document_type_by_country")
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  verified  Boolean  @default(false)
}

model Category {
  id             Int                   @id @default(autoincrement())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  services       Service[]
  UserCategories UserCategory[]
  translations   CategoryTranslation[]
}

model CategoryTranslation {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  language    String // 'es' o 'en'
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, language])
  @@index([language])
  @@map("category_translation")
}

model Service {
  id           Int                  @id @default(autoincrement())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  categoryId   Int
  category     Category             @relation(fields: [categoryId], references: [id])
  prices       Price[]
  translations ServiceTranslation[]

  @@index([categoryId])
}

model ServiceTranslation {
  id          Int     @id @default(autoincrement())
  service     Service @relation(fields: [serviceId], references: [id])
  serviceId   Int
  language    String // 'es' | 'en'
  name        String
  description String?
}

model Price {
  id        Int     @id @default(autoincrement())
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int
  amount    Float
  duration  Int // en minutos
  currency  String  @default("EUR") // EUR implica España
}

model UserCategory {
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     Users    @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([userId, categoryId]) // Clave compuesta para evitar duplicados de User-Category
  @@map("user_category")
}

model UserLocation {
  id        Int      @id @default(autoincrement()) @map("id")
  latitude  Float    @map("latitude")
  longitude Float    @map("longitude")
  address   String?  @map("address") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId Int   @unique @map("user_id")
  user   Users @relation("UserToLocation", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")  
}