generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id             Int            @id @default(autoincrement()) @map("id")
  email          String         @unique @map("email") @db.VarChar(100)
  clientType     ClientType     @default(people) @map("client_type")
  state          ClientState    @default(disabled) @map("state")
  acceptTerms    Boolean        @default(false) @map("accept_terms")
  acceptPolitics Boolean        @default(false) @map("accept_polits")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  fotoPerfil     String?        @map("foto_perfil")
  UserAuth       UserAuth?      @relation("UserToUserAuth")
  UserCategories UserCategory[]
  UserData       UserData?      @relation("UserToUserData")
  UserLocation   UserLocation?  @relation("UserToLocation")
  resenas        Resena[]     @relation("UserToResena")

  @@index([email])
  @@map("users")
  Appointment Appointment[]
}

model UserAuth {
  id        Int      @id @default(autoincrement()) @map("id")
  email     String   @unique @map("email")
  password  String   @map("password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user_id   Int      @unique @map("user_id")
  user      Users    @relation("UserToUserAuth", fields: [user_id], references: [id])

  @@map("user_auth")
}

model UserData {
  id        Int     @id @default(autoincrement()) @map("id")
  name      String  @map("name") @db.VarChar(50)
  phone     String    @unique @map("phone") @db.VarChar(20) // Campo phone en UserData
  email     String    @unique @map("email")
  userId    Int     @unique @map("user_id")
  countryId Int     @map("country_id")
  idioma    String  @map("idioma") @db.VarChar(50)
  gender    String  @db.VarChar(50)
  birthdate DateTime?
  country   Country @relation(fields: [countryId], references: [id])
  user      Users   @relation("UserToUserData", fields: [userId], references: [id])

  @@map("user_data")
}

model Country {
  id            Int                     @id @default(autoincrement()) @map("id")
  name          String                  @map("name")
  isoCode       String                  @unique @map("iso_code") @db.Char(2)
  flagUrl       String?                 @map("flag_url")
  dialingCode   String                  @map("dialing_code") @db.VarChar(10)
  DocumentTypes DocumentTypeByCountry[]
  UserData      UserData[]

  @@map("country")
}

model DocumentType {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique
  acronym       String
  type          ClientType              @default(people)
  DocumentTypes DocumentTypeByCountry[]

  @@map("document_type")
}

model DocumentTypeByCountry {
  countryId      Int          @map("country_id")
  documentTypeId Int          @map("document_type_id")
  country        Country      @relation(fields: [countryId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@id([countryId, documentTypeId])
  @@map("document_type_by_country")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String     @map("email")
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  verified  Boolean  @default(false)
}

model Category {
  id             Int                   @id @default(autoincrement())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
   image          String?  
  services       Service[]
  translations   CategoryTranslation[]
  UserCategories UserCategory[]
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  language    String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, language])
  @@index([language])
  @@map("category_translation")
}


model Price {
  id        Int     @id @default(autoincrement())
  serviceId Int
  amount    Float
  duration  Int
  currency  String  @default("EUR")
  service   Service @relation(fields: [serviceId], references: [id])
}

model UserCategory {
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  category   Category @relation(fields: [categoryId], references: [id])
  user       Users    @relation(fields: [userId], references: [id])

  @@id([userId, categoryId])
  @@map("user_category")
}

model UserLocation {
  id        Int      @id @default(autoincrement()) @map("id")
  latitude  Float    @map("latitude")
  longitude Float    @map("longitude")
  address   String?  @map("address") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int      @unique @map("user_id")
  user      Users    @relation("UserToLocation", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

enum ClientType {
  people // usuario persona
  business // usuario empresa
}

enum ClientState {
  enabled
  disabled
  blocked
}


model Empresa {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  telefono    String?  @map("telefono")
  email       String?  @map("email")
  nit         String?  @map("nit")
  logo        String?  @map("logo_url") // URL del logo
  descripcion String?  @map("descripcion")
  descripcionLarga String?  @map("descripcion_larga")
  facebookUrl      String?  @map("facebook_url")
  instagramUrl     String?  @map("instagram_url")
  tiktokUrl        String?  @map("tiktok_url")
  webUrl           String?  @map("web_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  sedes Sede[] // Una empresa puede tener muchas sedes

  @@map("empresas")
}

model Sede {
  id              Int      @id @default(autoincrement())
  nombre          String
  direccion       String
  telefono        String?
  latitud         Float?
  longitud        Float?
  provincia       String?
  horario         Json?
  diasCerrado     Json?
  imagenes        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  empresaId       Int
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  
  profesionales   Profesional[]
  resenas         Resena[]
  galeria         Galeria[]
  serviceSedeProfesional ServiceSedeProfesional[]
  Appointment Appointment[]
   HorarioSede HorarioSede[]
  DiaCerradoSede DiaCerradoSede[]
  @@map("sedes")
  
  Service Service[] @relation("SedeServicios")
}

model Profesional {
  id           Int      @id @default(autoincrement())
  nombre       String
  biografia    String?
  imagen       String?
  phone        String    @unique @map("phone") @db.VarChar(20) 
  state        ClientState    @default(enabled) @map("state")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt  
  sedeId       Int
  sede         Sede     @relation(fields: [sedeId], references: [id])
 servicios   Service[] // Relación de muchos a muchos
 serviceSedeProfesional ServiceSedeProfesional[]
 Appointment Appointment[]
  DisponibilidadProfesional DisponibilidadProfesional[]
  @@map("profesionales")
  
}

enum ResenaState {
  PENDIENTE
  APROBADA
  RECHAZADA
}
enum ResenaType {
  SEDE
  SERVICIO
}


model Resena {
  id            Int           @id @default(autoincrement())
  calificacion  Float
  comentario    String?
  aprobado      Boolean       @default(false)
  estado        ResenaState
  tipo          ResenaType
  
  sedeId        Int?
  sede          Sede?         @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  
  serviceId     Int?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  
   usuarioId    Int
  usuario      Users    @relation("UserToResena", fields: [usuarioId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Se asegura de que solo uno de los campos de relación (sedeId, serviceId) esté presente
  @@index([sedeId])
  @@index([serviceId])
  
  @@map("resenas")
}



model Galeria {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sedeId      Int
  sede        Sede     @relation(fields: [sedeId], references: [id])

  @@map("galerias")
}



model Service {
  id               Int                @id @default(autoincrement())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categoryId       Int
  prices           Price[]
  category         Category           @relation(fields: [categoryId], references: [id])
  translations     ServiceTranslation[]
  imagenes         String[]
  profesionales    Profesional[] // Relación de muchos a muchos
  resenas          Resena[]
 serviceSedeProfesional ServiceSedeProfesional[]
  sedes            Sede[]               @relation("SedeServicios")
  @@index([categoryId])
  @@map("servicios")
  Appointment Appointment[]
}


model ServiceTranslation {
  id          Int       @id @default(autoincrement())
  serviceId   Int
  language    String
  name        String
  description String?
  service     Service @relation(fields: [serviceId], references: [id])
}

// ESTA ES LA TABLA CLAVE que relaciona los datos.
// Conecta `Sede`, `Service` y `Profesional`.
model ServiceSedeProfesional {
  id             Int          @id @default(autoincrement())
  
  sedeId         Int
  sede           Sede         @relation(fields: [sedeId], references: [id])
  
  serviceId      Int
  service        Service      @relation(fields: [serviceId], references: [id])
  
  profesionalId  Int?
  profesional    Profesional? @relation(fields: [profesionalId], references: [id])
  
  @@unique([sedeId, serviceId, profesionalId]) // Esto evita duplicados
  @@map("service_sede_profesional")
}


enum AppointmentStatus {
  PENDING    // pendiente de confirmación
  CONFIRMED  // confirmada
  COMPLETED  // completada
  CANCELLED  // cancelada
  NO_SHOW    // el cliente no asistió
}



model Appointment {
  id              Int         @id @default(autoincrement())
  fecha           DateTime
  horaInicio      DateTime          // inicio
  horaFin         DateTime          // fin
  duracion        Int               // minutos
  estado          AppointmentStatus @default(PENDING)
  notas           String?           // notas opcionales
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sedeId          Int
  sede            Sede        @relation(fields: [sedeId], references: [id])

  serviceId       Int
  service         Service     @relation(fields: [serviceId], references: [id])

  profesionalId   Int
  profesional     Profesional @relation(fields: [profesionalId], references: [id])

   userId          Int
   user            Users             @relation(fields: [userId], references: [id])

  @@index([fecha])
  @@index([profesionalId, fecha])
  @@index([sedeId, fecha])
  @@unique([profesionalId, horaInicio]) // evita doble reserva a la misma hora

   Payment Payment[]
}

model HorarioSede {
  id        Int      @id @default(autoincrement())
  sedeId    Int
  diaSemana Int      // 0=Domingo, 1=Lunes, etc.
  horaApertura String
  horaCierre   String
  activo    Boolean  @default(true)

  sede      Sede     @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, diaSemana])
  @@map("horario_sede")
}

model DiaCerradoSede {
  id          Int      @id @default(autoincrement())
  sedeId      Int
  fecha       DateTime // fecha cerrada
  motivo      String?
  todoElDia   Boolean  @default(true)
  horaInicio  String?
  horaFin     String?

  sede        Sede     @relation(fields: [sedeId], references: [id])

  @@index([sedeId, fecha])
  @@map("dias_cerrados_sede")
}

model DisponibilidadProfesional {
  id             Int      @id @default(autoincrement())
  profesionalId  Int
  fecha          DateTime // día específico
  disponible     Boolean  @default(true)
  horaInicio     String?  // rango inicio
  horaFin        String?  // rango fin
  motivo         String?  // motivo (vacaciones, enfermedad, etc.)

  profesional    Profesional @relation(fields: [profesionalId], references: [id])

  @@index([profesionalId, fecha])
  @@unique([profesionalId, fecha])
  @@map("disponibilidad_profesional")
}


enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  RESERVED
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id               Int             @id @default(autoincrement())
  appointmentId    Int             @unique
  appointment      Appointment     @relation(fields: [appointmentId], references: [id])
  method           PaymentMethod
  status           PaymentStatus   @default(PENDING)
  totalAmount      Float
  reservedAmount   Float?          // monto parcial si es pago en establecimiento
  paidAmount       Float?          // cuánto se ha pagado
  transactionId    String?
  bankResponse     Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("payments")
}