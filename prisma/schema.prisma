generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                                               Int            @id @default(autoincrement()) @map("id")
  email                                            String         @unique @map("email") @db.VarChar(100)
  clientType                                       ClientType     @default(people) @map("client_type")
  state                                            ClientState    @default(disabled) @map("state")
  acceptTerms                                      Boolean        @default(false) @map("accept_terms")
  acceptPolitics                                   Boolean        @default(false) @map("accept_polits")
  createdAt                                        DateTime       @default(now()) @map("created_at")
  updatedAt                                        DateTime       @updatedAt @map("updated_at")
  fotoPerfil                                       String?        @map("foto_perfil")
  role                                             Role           @default(CLIENT) @map("role")
  status_id                                        Int?           @default(7)
  Appointment                                      Appointment[]
  AdminProfile                                     AdminProfile?
  chat_chat_receiver_idTousers                     chat[]         @relation("chat_receiver_idTousers")
  chat_chat_sender_idTousers                       chat[]         @relation("chat_sender_idTousers")
  chat_contact_chat_contact_owner_user_idTousers   chat_contact[] @relation("chat_contact_owner_user_idTousers")
  chat_contact_chat_contact_contact_user_idTousers chat_contact[] @relation("chat_contact_contact_user_idTousers")
  chat_log                                         chat_log[]
  paymentCards                                     PaymentCard[]
  payments                                         Payment[]
  profesionales                                    Profesional?
  resenas                                          Resena[]       @relation("UserToResena")
  UserAuth                                         UserAuth?      @relation("UserToUserAuth")
  UserCategories                                   UserCategory[]
  UserData                                         UserData?      @relation("UserToUserData")
  UserLocation                                     UserLocation?  @relation("UserToLocation")
  UserStatus                                       UserStatus?    @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_status")

  @@index([email])
  @@map("users")
}

model AdminProfile {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    Int      @unique @map("user_id")
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  phone     String?  @map("phone") @db.VarChar(20)
  photoUrl  String?  @map("photo_url")
  empresaId Int?     @map("empresa_id")
  sedeId    Int?     @map("sede_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  sede      Sede?    @relation(fields: [sedeId], references: [id])
  user      Users    @relation(fields: [userId], references: [id])

  @@map("admin_profiles")
}

model UserAuth {
  id        Int      @id @default(autoincrement()) @map("id")
  email     String   @unique @map("email")
  password  String   @map("password")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user_id   Int      @unique @map("user_id")
  user      Users    @relation("UserToUserAuth", fields: [user_id], references: [id])

  @@map("user_auth")
}

model UserData {
  id        Int       @id @default(autoincrement()) @map("id")
  name      String    @map("name") @db.VarChar(50)
  phone     String    @unique @map("phone") @db.VarChar(20)
  email     String    @unique @map("email")
  userId    Int       @unique @map("user_id")
  countryId Int       @map("country_id")
  idioma    String    @map("idioma") @db.VarChar(50)
  gender    String    @db.VarChar(50)
  birthdate DateTime?
  direccion String?   @map("direccion") @db.VarChar(255)
  country   Country   @relation(fields: [countryId], references: [id])
  user      Users     @relation("UserToUserData", fields: [userId], references: [id])

  @@map("user_data")
}

model Country {
  id            Int                     @id @default(autoincrement()) @map("id")
  name          String                  @map("name")
  isoCode       String                  @unique @map("iso_code") @db.Char(2)
  flagUrl       String?                 @map("flag_url")
  dialingCode   String                  @map("dialing_code") @db.VarChar(10)
  DocumentTypes DocumentTypeByCountry[]
  UserData      UserData[]

  @@map("country")
}

model DocumentType {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique
  acronym       String
  type          ClientType              @default(people)
  DocumentTypes DocumentTypeByCountry[]

  @@map("document_type")
}

model DocumentTypeByCountry {
  countryId      Int          @map("country_id")
  documentTypeId Int          @map("document_type_id")
  country        Country      @relation(fields: [countryId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@id([countryId, documentTypeId])
  @@map("document_type_by_country")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @map("email")
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  verified  Boolean  @default(false)
}

model Category {
  id             Int                   @id @default(autoincrement())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  image          String?
  translations   CategoryTranslation[]
  services       Service[]
  UserCategories UserCategory[]
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  language    String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, language])
  @@index([language])
  @@map("category_translation")
}

model Price {
  id        Int     @id @default(autoincrement())
  serviceId Int
  amount    Float
  duration  Int
  currency  String  @default("EUR")
  service   Service @relation(fields: [serviceId], references: [id])
}

model UserCategory {
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  category   Category @relation(fields: [categoryId], references: [id])
  user       Users    @relation(fields: [userId], references: [id])

  @@id([userId, categoryId])
  @@map("user_category")
}

model UserLocation {
  id        Int      @id @default(autoincrement()) @map("id")
  latitude  Float    @map("latitude")
  longitude Float    @map("longitude")
  address   String?  @map("address") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int      @unique @map("user_id")
  user      Users    @relation("UserToLocation", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

model Empresa {
  id               Int            @id @default(autoincrement())
  nombre           String         @unique
  telefono         String?        @map("telefono")
  email            String?        @map("email")
  nit              String?        @map("nit")
  logo             String?        @map("logo_url")
  descripcion      String?        @map("descripcion")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  descripcionLarga String?        @map("descripcion_larga")
  facebookUrl      String?        @map("facebook_url")
  instagramUrl     String?        @map("instagram_url")
  tiktokUrl        String?        @map("tiktok_url")
  webUrl           String?        @map("web_url")
  adminProfiles    AdminProfile[]
  sedes            Sede[]

  @@map("empresas")
}

model Sede {
  id                     Int                      @id @default(autoincrement())
  nombre                 String
  direccion              String
  telefono               String?
  latitud                Float?
  longitud               Float?
  provincia              String?
  horario                Json?
  diasCerrado            Json?
  imagenes               String[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  empresaId              Int
  Appointment            Appointment[]
  adminProfiles          AdminProfile[]
  DiaCerradoSede         DiaCerradoSede[]
  galeria                Galeria[]
  HorarioSede            HorarioSede[]
  profesionales          Profesional[]
  resenas                Resena[]
  empresa                Empresa                  @relation(fields: [empresaId], references: [id])
  serviceSedeProfesional ServiceSedeProfesional[]
  Service                Service[]                @relation("SedeServicios")

  @@map("sedes")
}

model Profesional {
  id                        Int                         @id @default(autoincrement())
  nombre                    String
  biografia                 String?
  imagen                    String?
  phone                     String                      @unique @map("phone") @db.VarChar(20)
  state                     ClientState                 @default(enabled) @map("state")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  sedeId                    Int
  user_id                   Int?                        @unique
  Appointment               Appointment[]
  DisponibilidadProfesional DisponibilidadProfesional[]
  sede                      Sede                        @relation(fields: [sedeId], references: [id])
  users                     Users?                      @relation(fields: [user_id], references: [id])
  serviceSedeProfesional    ServiceSedeProfesional[]
  servicios                 Service[]                   @relation("ProfesionalToService")

  @@index([user_id])
  @@map("profesionales")
}

model Resena {
  id           Int         @id @default(autoincrement())
  calificacion Float
  comentario   String?
  aprobado     Boolean     @default(false)
  estado       ResenaState
  tipo         ResenaType
  sedeId       Int?
  usuarioId    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sede         Sede?       @relation(fields: [sedeId], references: [id])
  usuario      Users       @relation("UserToResena", fields: [usuarioId], references: [id])

  @@index([sedeId])
  @@map("resenas")
}

model Galeria {
  id          Int      @id @default(autoincrement())
  url         String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sedeId      Int
  sede        Sede     @relation(fields: [sedeId], references: [id])

  @@map("galerias")
}

model Service {
  id                     Int                      @id @default(autoincrement())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  categoryId             Int
  imagenes               String[]
  Appointment            Appointment[]
  prices                 Price[]
  translations           ServiceTranslation[]
  payments               Payment[]
  serviceSedeProfesional ServiceSedeProfesional[]
  category               Category                 @relation(fields: [categoryId], references: [id])
  profesionales          Profesional[]            @relation("ProfesionalToService")
  sedes                  Sede[]                   @relation("SedeServicios")

  @@index([categoryId])
  @@map("servicios")
}

model ServiceTranslation {
  id          Int     @id @default(autoincrement())
  serviceId   Int
  language    String
  name        String
  description String?
  service     Service @relation(fields: [serviceId], references: [id])
}

model ServiceSedeProfesional {
  id            Int          @id @default(autoincrement())
  sedeId        Int
  serviceId     Int
  profesionalId Int?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])
  sede          Sede         @relation(fields: [sedeId], references: [id])
  service       Service      @relation(fields: [serviceId], references: [id])

  @@unique([sedeId, serviceId, profesionalId])
  @@map("service_sede_profesional")
}

model Appointment {
  id            Int               @id @default(autoincrement())
  fecha         DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sedeId        Int
  serviceId     Int
  profesionalId Int
  duracion      Int
  estado        AppointmentStatus @default(PENDING)
  horaFin       DateTime
  horaInicio    DateTime
  notas         String?
  userId        Int
  profesional   Profesional       @relation(fields: [profesionalId], references: [id])
  sede          Sede              @relation(fields: [sedeId], references: [id])
  service       Service           @relation(fields: [serviceId], references: [id])
  user          Users             @relation(fields: [userId], references: [id])
  Payment       Payment?

  @@unique([profesionalId, horaInicio])
  @@index([fecha])
  @@index([profesionalId, fecha])
  @@index([sedeId, fecha])
}

model HorarioSede {
  id           Int     @id @default(autoincrement())
  sedeId       Int
  diaSemana    Int
  horaApertura String
  horaCierre   String
  activo       Boolean @default(true)
  sede         Sede    @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, diaSemana])
  @@map("horario_sede")
}

model DiaCerradoSede {
  id         Int      @id @default(autoincrement())
  sedeId     Int
  fecha      DateTime
  motivo     String?
  todoElDia  Boolean  @default(true)
  horaInicio String?
  horaFin    String?
  sede       Sede     @relation(fields: [sedeId], references: [id])

  @@index([sedeId, fecha])
  @@map("dias_cerrados_sede")
}

model DisponibilidadProfesional {
  id            Int         @id @default(autoincrement())
  profesionalId Int
  fecha         DateTime
  disponible    Boolean     @default(true)
  horaInicio    String?
  horaFin       String?
  motivo        String?
  profesional   Profesional @relation(fields: [profesionalId], references: [id])

  @@unique([profesionalId, fecha])
  @@index([profesionalId, fecha])
  @@map("disponibilidad_profesional")
}

model Payment {
  id             Int           @id @default(autoincrement())
  appointmentId  Int           @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  totalAmount    Float
  reservedAmount Float?
  paidAmount     Float?
  transactionId  String?
  bankResponse   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cardId         Int?
  serviceId      Int
  userId         Int
  appointment    Appointment   @relation(fields: [appointmentId], references: [id])
  card           PaymentCard?  @relation(fields: [cardId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])
  user           Users         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([serviceId])
  @@index([cardId])
  @@map("payments")
}

model PaymentCard {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  brand          String    @db.VarChar(50)
  last4          String    @db.Char(4)
  expiryMonth    Int       @map("expiry_month")
  expiryYear     Int       @map("expiry_year")
  cardholderName String    @map("cardholder_name") @db.VarChar(150)
  token          String?   @map("token")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           Users     @relation(fields: [userId], references: [id])
  payments       Payment[]

  @@index([userId])
  @@map("payment_cards")
}

model UserStatus {
  id                    Int                     @id @default(autoincrement())
  code                  String                  @unique @db.VarChar(50)
  createdAt             DateTime                @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                @default(now()) @db.Timestamp(6)
  UserStatusTranslation UserStatusTranslation[]
  users                 Users[]
}

model UserStatusTranslation {
  id           Int        @id @default(autoincrement())
  userStatusId Int
  language     String
  name         String
  description  String?
  UserStatus   UserStatus @relation(fields: [userStatusId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_status_translation")
}

model chat {
  id                            Int        @id @default(autoincrement())
  sender_id                     Int
  receiver_id                   Int
  sender_email                  String     @db.VarChar(100)
  receiver_email                String     @db.VarChar(100)
  message_type                  String     @default("TEXT") @db.VarChar(20)
  message                       String?
  file_url                      String?
  is_read                       Boolean    @default(false)
  read_at                       DateTime?  @db.Timestamp(6)
  created_at                    DateTime   @default(now()) @db.Timestamp(6)
  updated_at                    DateTime   @default(now()) @db.Timestamp(6)
  users_chat_receiver_idTousers Users      @relation("chat_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_receiver")
  users_chat_sender_idTousers   Users      @relation("chat_sender_idTousers", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_sender")
  chat_log                      chat_log[]
}

model chat_log {
  id         Int      @id @default(autoincrement())
  chat_id    Int
  user_id    Int?
  action     String   @db.VarChar(50)
  details    Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_log_chat")
  users      Users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_log_user")

  @@index([action], map: "idx_chat_log_action")
  @@index([chat_id], map: "idx_chat_log_chat_id")
  @@index([created_at], map: "idx_chat_log_created_at")
  @@index([user_id], map: "idx_chat_log_user_id")
}

model chat_contact {
  id                                        Int      @id @default(autoincrement())
  owner_user_id                             Int
  contact_user_id                           Int
  created_at                                DateTime @default(now()) @db.Timestamp(6)
  users_chat_contact_owner_user_idTousers   Users    @relation("chat_contact_owner_user_idTousers", fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_contact_owner")
  users_chat_contact_contact_user_idTousers Users    @relation("chat_contact_contact_user_idTousers", fields: [contact_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_contact_user")

  @@unique([owner_user_id, contact_user_id], map: "uq_chat_contact")
}

enum ClientType {
  people
  business
}

enum ClientState {
  enabled
  disabled
  blocked
}



enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  BRANCH_ADMIN
  EMPLOYEE
  CLIENT
}

enum ResenaState {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ResenaType {
  SEDE
  SERVICIO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  RESERVED
  PAID
  FAILED
  CANCELLED
}
